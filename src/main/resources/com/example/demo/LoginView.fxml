<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.LoginController"
            prefHeight="620" prefWidth="760"
            style="-fx-background-color: linear-gradient(to bottom right, #E8F1FF, #F8FBFF);">

    <top>
        <VBox spacing="8" style="-fx-padding: 30 30 10 30;">
            <Label text="Smart Diary"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1E3A5F;"/>
            <Label text="Log in or create an account to open your personal calendar."
                   style="-fx-font-size: 14px; -fx-text-fill: #51657E;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18" style="-fx-padding: 10 30 30 30;">
            <TabPane tabClosingPolicy="UNAVAILABLE" prefWidth="700">
                <tabs>
                    <Tab text="Login">
                        <VBox spacing="18" style="-fx-padding: 24; -fx-background-color: white;">
                            <GridPane hgap="12" vgap="12">
                                <padding>
                                    <Insets top="6" right="6" bottom="6" left="6"/>
                                </padding>

                                <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="loginUsernameField"
                                           promptText="Enter username"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="loginPasswordField"
                                               promptText="Enter password"
                                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </GridPane>

                            <Button text="Login"
                                    onAction="#login"
                                    prefWidth="180"
                                    style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;"/>

                            <Separator/>

                            <Label text="Default seeded accounts use password: password"
                                   style="-fx-text-fill: #6B7280;"/>
                        </VBox>
                    </Tab>

                    <Tab text="Register">
                        <VBox spacing="18" style="-fx-padding: 24; -fx-background-color: white;">
                            <GridPane hgap="12" vgap="12">
                                <padding>
                                    <Insets top="6" right="6" bottom="6" left="6"/>
                                </padding>

                                <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="registerUsernameField"
                                           promptText="Choose username"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Full name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="registerFullNameField"
                                           promptText="Your full name"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="registerEmailField"
                                           promptText="name@example.com"
                                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="registerPasswordField"
                                               promptText="Create password"
                                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Confirm password:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="registerConfirmPasswordField"
                                               promptText="Repeat password"
                                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            </GridPane>

                            <Button text="Create Account"
                                    onAction="#register"
                                    prefWidth="180"
                                    style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: rgba(255,255,255,0.92); -fx-padding: 12 16 12 16; -fx-background-radius: 8;">
                <Label text="Status:" style="-fx-font-weight: bold;"/>
                <Label fx:id="authStatusLabel" text="Use login or registration to continue."/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
